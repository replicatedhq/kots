contents:
  repositories:
    - https://apk.cve0.io
    - ./packages/
  keyring:
    - https://apk.cve0.io/key/cve0-signing.rsa.pub
    - ./melange-arm64.rsa.pub
    - ./melange-amd64.rsa.pub
  packages:
    - kotsadm-migrations-head  # This is expected to be built locally by `melange`.
    - bash
    - busybox
    - curl
    - git
    - ca-certificates
    - securebuild-baselayout
    # schemahero v0.25.x ships each DB driver as a separate go-plugin binary
    # (installed to /var/lib/schemahero/plugins). This image runs the schemahero
    # CLI against rqlite (schemahero-plan/apply init containers), so it needs the
    # rqlite plugin. Pin the CLI + plugin to the 0.25 series so they match the
    # schemahero library version in go.mod. The plugin is installed into the
    # image at build time, so nothing is downloaded at runtime (airgap-safe).
    - schemahero-0.25
    - schemahero-0.25-rqlite

accounts:
  groups:
    - groupname: schemahero
      gid: 1001
  users:
    - username: schemahero
      uid: 1001
      gid: 1001
  run-as: schemahero

environment:
  VERSION: ${GIT_TAG}

entrypoint:
  command: /usr/bin/schemahero

cmd: apply
